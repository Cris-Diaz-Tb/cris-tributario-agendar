# ─── Encuadrado (solo server-side, NUNCA con prefijo NEXT_PUBLIC_) ───
ENCUADRADO_API_KEY=
ENCUADRADO_SERVICE_UUID=0dca1bcd-0abe-4618-95f4-355b7c13574a

# Dominio público (el que ve el usuario vía Cloudflare Worker). Sin slash final.
SITE_URL=https://cristributario.cl

# Webhook de n8n (secreto: quien tenga la URL puede enviar eventos)
N8N_WEBHOOK_URL=https://pendiente.n8n.cloud/webhook/pendiente
# Secreto compartido con n8n; se envía en el header X-CT-Webhook-Secret
N8N_WEBHOOK_SECRET=

# Meta Pixel (público por diseño, va al navegador)
NEXT_PUBLIC_META_PIXEL_ID=

# Precio del servicio en CLP (entero, sin puntos). Se envía como `value`.
SERVICE_PRICE_CLP=0

# Términos y condiciones (link del checkbox)
TERMS_URL=https://cristributario.cl/terminos-y-condiciones

# ─── Flags de prueba / activación ───
# true = POST /bookings NO llama a Encuadrado; devuelve respuestas simuladas.
ENCUADRADO_DRY_RUN=true
# Escenario simulado cuando DRY_RUN=true:
#   prepaid | prepaid_redirect_rejected | confirmed | booking_failed | rate_limited
ENCUADRADO_DRY_RUN_SCENARIO=prepaid

# Disparo de Pixel Schedule/Purchase en /agendamiento-exitoso.
# Dejar en false hasta confirmar qué parámetros agrega Encuadrado al redirect.
CONVERSION_EVENTS_ENABLED=false
# Opcional: exigir un query param para considerar el pago confirmado, formato clave=valor
# (ej. status=paid). Vacío = cualquier retorno cuenta (solo si el flag de arriba es true).
PAYMENT_SUCCESS_PARAM=
